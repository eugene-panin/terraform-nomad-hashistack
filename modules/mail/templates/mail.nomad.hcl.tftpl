job "${job_name}" {
  namespace   = "${namespace}"
  datacenters = ${jsonencode(datacenters)}
  type        = "service"

  meta {
    config_version = "${config_version}"
  }

  group "mail" {
    network {
      port "smtp" {
        static       = 25
        host_network = "${public_host_network}"
      }

      port "submissions" {
        static       = 465
        host_network = "${public_host_network}"
      }

      port "submission" {
        static       = 587
        host_network = "${public_host_network}"
      }

      port "imaps" {
        static       = 993
        host_network = "${public_host_network}"
      }

      port "https" {
        host_network = "${internal_network}"
      }

      port "recovery" {
        host_network = "${internal_network}"
      }
    }

    volume "data" {
      type            = "host"
      source          = "${volume_name}"
      access_mode     = "single-node-writer"
      attachment_mode = "file-system"
    }

    service {
      name     = "${job_name}"
      port     = "https"
      provider = "consul"
      tags = [
        "traefik.enable=true",
        "traefik.tcp.routers.${job_name}.rule=${join(" || ", [for n in tls_names : "HostSNI(`${n}`)"])}",
        "traefik.tcp.routers.${job_name}.entrypoints=${traefik.entrypoint}",
        "traefik.tcp.routers.${job_name}.tls.passthrough=true",
        "traefik.tcp.services.${job_name}.loadbalancer.serverstransport=${traefik.servers_transport}",
      ]

      check {
        type     = "tcp"
        interval = "10s"
        timeout  = "2s"
      }
    }

    task "setup" {
      driver = "exec"
      user   = "nobody"

      lifecycle {
        hook    = "prestart"
        sidecar = false
      }

      artifact {
        source      = "https://github.com/stalwartlabs/stalwart/releases/download/v${stalwart.version}/stalwart-$${attr.kernel.arch}-unknown-linux-musl.tar.gz"
        destination = "local/stalwart.tar.gz"
        mode        = "file"

        options {
          archive = "false"
        }
      }

      artifact {
        source      = "https://github.com/stalwartlabs/cli/releases/download/v${stalwart.cli}/stalwart-cli-$${attr.kernel.arch}-unknown-linux-musl.tar.xz"
        destination = "local/cli"

        options {
          checksum = "file:https://github.com/stalwartlabs/cli/releases/download/v${stalwart.cli}/sha256.sum"
        }
      }

      config {
        command = "/bin/sh"
        args    = ["/local/setup.sh"]
      }

      volume_mount {
        volume      = "data"
        destination = "/data"
      }

      vault {}

      env {
        TMPDIR = "/local"
%{ if acme_ca_certificate != null ~}
        SSL_CERT_FILE = "/alloc/ca.pem"
%{ endif ~}
      }

%{ if acme_ca_certificate != null ~}
      template {
        destination     = "local/acme-ca.pem"
        left_delimiter  = "[["
        right_delimiter = "]]"
        data            = <<-EOT
${acme_ca_certificate}
        EOT
      }

%{ endif ~}
      template {
        destination     = "local/stalwart.sha256"
        left_delimiter  = "[["
        right_delimiter = "]]"
        data            = <<-EOT
%{ for arch, sum in stalwart.sha256 ~}
          ${sum}  stalwart-${arch}-unknown-linux-musl.tar.gz
%{ endfor ~}
        EOT
      }

      template {
        destination     = "local/config.json"
        left_delimiter  = "[["
        right_delimiter = "]]"
        data            = <<-EOT
          {"@type":"RocksDb","path":"/data"}
        EOT
      }

      template {
        destination = "secrets/recovery.env"
        env         = true
        data        = <<-EOT
          {{ with secret "${secret_path}" }}STALWART_RECOVERY_ADMIN=admin:{{ .Data.data.recovery_password }}
          STALWART_PASSWORD={{ .Data.data.recovery_password }}{{ end }}
        EOT
      }

      template {
        destination = "secrets/plan.ndjson"
        data        = <<-EOT
          {{ with secret "${secret_path}" }}{{ .Data.data.plan }}{{ end }}
          {"@type":"upsert","object":"NetworkListener","matchOn":["name"],"value":{"smtp":{"name":"smtp","protocol":"smtp","bind":{"{{ env "NOMAD_ADDR_smtp" }}":true}},"submissions":{"name":"submissions","protocol":"smtp","bind":{"{{ env "NOMAD_ADDR_submissions" }}":true},"useTls":true,"tlsImplicit":true},"submission":{"name":"submission","protocol":"smtp","bind":{"{{ env "NOMAD_ADDR_submission" }}":true}},"imaps":{"name":"imaps","protocol":"imap","bind":{"{{ env "NOMAD_ADDR_imaps" }}":true},"useTls":true,"tlsImplicit":true},"https":{"name":"https","protocol":"http","bind":{"{{ env "NOMAD_ADDR_https" }}":true},"useTls":true,"tlsImplicit":true,"overrideProxyTrustedNetworks":{"{{ env "NOMAD_IP_https" }}/32":true}}}}
        EOT
      }

      template {
        destination     = "local/setup.sh"
        left_delimiter  = "[["
        right_delimiter = "]]"
        data            = <<-EOT
          set -eu
          arch=$(uname -m)
          expected=$(awk -v f="stalwart-$arch-unknown-linux-musl.tar.gz" '$2 == f { print $1 }' /local/stalwart.sha256)
          [ -n "$expected" ] || { echo "no checksum for $arch" >&2; exit 1; }
          echo "$expected  /local/stalwart.tar.gz" | sha256sum -c -
          mkdir -p /alloc/bin
          tar -xzf /local/stalwart.tar.gz -C /alloc/bin stalwart
          chmod 0755 /alloc/bin/stalwart
%{ if acme_ca_certificate != null ~}
          cat /etc/ssl/certs/ca-certificates.crt /local/acme-ca.pem > /alloc/ca.pem
%{ endif ~}
          STALWART_RECOVERY_MODE=1 STALWART_RECOVERY_MODE_PORT="$NOMAD_PORT_recovery" /alloc/bin/stalwart --config /local/config.json &
          server=$!
          trap 'kill "$server" 2>/dev/null || true' EXIT
          export STALWART_URL="http://127.0.0.1:$NOMAD_PORT_recovery" STALWART_USER=admin
          cli="/local/cli/stalwart-cli-$arch-unknown-linux-musl/stalwart-cli"
          tries=0
          until "$cli" describe >/dev/null 2>&1; do
            kill -0 "$server"
            tries=$((tries + 1))
            [ "$tries" -lt 60 ] || { echo "the recovery server did not answer" >&2; exit 1; }
            sleep 1
          done
          "$cli" --no-color apply --file /secrets/plan.ndjson
          kill "$server"
          wait "$server" || true
        EOT
      }

      resources {
        cpu    = 200
        memory = 512
      }
    }

    task "stalwart" {
      driver = "exec"
      user   = "nobody"

      config {
        command  = "/alloc/bin/stalwart"
        args     = ["--config", "/local/config.json"]
        cap_drop = ["all"]
        cap_add  = ["net_bind_service"]
      }

      volume_mount {
        volume      = "data"
        destination = "/data"
      }

      env {
        TMPDIR = "/local"
%{ if acme_ca_certificate != null ~}
        SSL_CERT_FILE = "/alloc/ca.pem"
%{ endif ~}
      }

      template {
        destination     = "local/config.json"
        left_delimiter  = "[["
        right_delimiter = "]]"
        data            = <<-EOT
          {"@type":"RocksDb","path":"/data"}
        EOT
      }

      resources {
        cpu    = 500
        memory = 1024
      }
    }
  }
}
