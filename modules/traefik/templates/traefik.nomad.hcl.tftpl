job "${job_name}" {
  namespace   = "${namespace}"
  datacenters = ${jsonencode(datacenters)}
  type        = "service"

  group "traefik" {
    network {
%{ if role == "internal" ~}
      port "internal" {
        static       = ${internal.port}
        host_network = "${internal.host_network}"
      }
%{ else ~}
      port "public_http" {
        static       = ${public.http_port}
        host_network = "${public.host_network}"
      }

      port "public_https" {
        static       = ${public.https_port}
        host_network = "${public.host_network}"
      }
%{ endif ~}
    }

%{ if role == "public" ~}
    volume "acme" {
      type            = "host"
      source          = "${volume_name}"
      access_mode     = "single-node-writer"
      attachment_mode = "file-system"
    }

%{ endif ~}
    service {
      name     = "${job_name}"
      port     = "${role == "internal" ? "internal" : "public_https"}"
      provider = "consul"

      check {
        type     = "tcp"
        interval = "10s"
        timeout  = "2s"
      }
    }

    task "traefik" {
      driver = "docker"

      config {
        image           = "${image}"
        network_mode    = "host"
        args            = ["--configfile=/local/traefik.yml"]
        readonly_rootfs = true
        cap_drop        = ["all"]
        cap_add         = ["net_bind_service"]
        security_opt    = ["no-new-privileges"]
      }

%{ if role == "public" ~}
      volume_mount {
        volume      = "acme"
        destination = "/acme"
      }

%{ endif ~}
      consul {}

%{ if role == "public" && acme_ca_certificate != null ~}
      env {
        LEGO_CA_CERTIFICATES = "/local/acme-ca.pem"
      }

      template {
        destination     = "local/acme-ca.pem"
        left_delimiter  = "[["
        right_delimiter = "]]"
        data            = <<-EOT
${acme_ca_certificate}
        EOT
      }

%{ endif ~}
%{ if consul.ca_pem != null ~}
      template {
        destination     = "local/consul-ca.pem"
        left_delimiter  = "[["
        right_delimiter = "]]"
        data            = <<-EOT
${consul.ca_pem}
        EOT
      }

%{ endif ~}
%{ if role == "internal" ~}
%{ if backend_ca_pem != null ~}
      template {
        destination     = "local/backend-ca.pem"
        left_delimiter  = "[["
        right_delimiter = "]]"
        data            = <<-EOT
${backend_ca_pem}
        EOT
      }

%{ endif ~}
      template {
        destination = "${secrets_dir}/internal-cert.pem"
        change_mode = "restart"
        data        = <<-EOT
          {{ with nomadVar "${variable_path}" }}{{ .tls_cert }}{{ end }}
        EOT
      }

      template {
        destination = "${secrets_dir}/internal-key.pem"
        change_mode = "restart"
        perms       = "600"
        data        = <<-EOT
          {{ with nomadVar "${variable_path}" }}{{ .tls_key }}{{ end }}
        EOT
      }

%{ endif ~}
      template {
        destination     = "local/traefik.yml"
        change_mode     = "restart"
        left_delimiter  = "[["
        right_delimiter = "]]"
        data            = <<-EOT
          log:
            level: INFO
%{ if role == "internal" && dashboard_host != null ~}
          api:
            dashboard: true
%{ endif ~}
          entryPoints:
%{ if role == "internal" ~}
            internal:
              address: "[[ env "NOMAD_IP_internal" ]]:[[ env "NOMAD_PORT_internal" ]]"
              asDefault: true
              http:
                tls: {}
%{ else ~}
            public-http:
              address: "[[ env "NOMAD_IP_public_http" ]]:[[ env "NOMAD_PORT_public_http" ]]"
              http:
                redirections:
                  entryPoint:
                    to: public-https
                    scheme: https
            public-https:
              address: "[[ env "NOMAD_IP_public_https" ]]:[[ env "NOMAD_PORT_public_https" ]]"
              http:
                tls:
                  certResolver: http
%{ endif ~}
          providers:
            consulCatalog:
              exposedByDefault: false
              prefix: traefik
              constraints: '${constraint}'
%{ if role == "internal" ~}
              defaultRule: 'Host(`{{ normalize .Name }}.${domain}`)'
%{ endif ~}
              endpoint:
                address: "${consul.address}"
                scheme: "${consul.scheme}"
%{ if consul.ca_pem != null ~}
                tls:
                  ca: /local/consul-ca.pem
%{ endif ~}
            file:
              filename: /local/dynamic.yml
              watch: true
%{ if role == "public" ~}
          certificatesResolvers:
            http:
              acme:
                email: "${acme_email}"
                caServer: "${acme_ca_server}"
                storage: /acme/http.json
                httpChallenge:
                  entryPoint: public-http
%{ endif ~}
        EOT
      }

      template {
        destination     = "local/dynamic.yml"
        change_mode     = "noop"
        left_delimiter  = "[["
        right_delimiter = "]]"
        data            = <<-EOT
%{ if role == "internal" ~}
          http:
            routers:
%{ for name, route in routes ~}
              ${name}:
                rule: 'Host(`${route.host}`)'
                service: ${name}
%{ endfor ~}
%{ if dashboard_host != null ~}
              dashboard:
                rule: 'Host(`${dashboard_host}`)'
                entryPoints: [internal]
                service: api@internal
%{ endif ~}
            services:
%{ for name, route in routes ~}
              ${name}:
                loadBalancer:
                  serversTransport: backend
                  servers:
                    - url: "${route.url}"
%{ endfor ~}
            serversTransports:
              backend:
%{ if backend_ca_pem != null ~}
                rootCAs:
                  - /local/backend-ca.pem
%{ endif ~}
                forwardingTimeouts:
                  dialTimeout: 10s
          tls:
            stores:
              default:
                defaultCertificate:
                  certFile: /${secrets_dir}/internal-cert.pem
                  keyFile: /${secrets_dir}/internal-key.pem
%{ else ~}
          tcp:
            serversTransports:
              proxy-protocol:
                proxyProtocol:
                  version: 2
%{ endif ~}
        EOT
      }

      resources {
        cpu        = 200
        memory     = 64
        memory_max = 256
      }
    }
  }
}
