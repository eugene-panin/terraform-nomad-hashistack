{
  "pebble": {
    "listenAddress": "0.0.0.0:14000",
    "managementListenAddress": "0.0.0.0:15000",
    "certificate": "/etc/pebble/generated/cert.pem",
    "privateKey": "/etc/pebble/generated/key.pem",
    "httpPort": 80,
    "tlsPort": 9443,
    "ocspResponderURL": "",
    "externalAccountBindingRequired": false,
    "retryAfter": {
      "authz": 1,
      "order": 1
    },
    "keyAlgorithm": "ecdsa",
    "profiles": {
      "default": {
        "description": "default",
        "validityPeriod": 7776000
      }
    }
  }
}
